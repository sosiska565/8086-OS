struct String { data: string; len: int; capacity: int; }

impl String {
    pub fn new() -> *String {
        let mut s: *String = alloc(12);
        s.capacity = 16; s.len = 0;
        s.data = alloc(16); s.data[0] = 0;
        return s;
    }

    pub fn push(self: *String, c: char) {
        if self.len + 1 >= self.capacity {
            self.capacity = self.capacity * 2;
            let mut new_data: string = alloc(self.capacity);
            let mut i: int = 0;
            while i < self.len { new_data[i] = self.data[i]; i++; }
            free(self.data); self.data = new_data;
        }
        self.data[self.len] = c; self.len++; self.data[self.len] = 0;
    }

    pub fn push_str(self: *String, other: string) {
        let mut i: int = 0;
        while other[i] != 0 { self.push(other[i]); i++; }
    }

    
    pub fn from(str: string) -> *String {
        let mut s: *String = String::new();
        s.push_str(str);
        return s;
    }

    pub fn eq(self: *String, other: string) -> int {
        let mut i: int = 0;
        while self.data[i] != 0 && other[i] != 0 { if self.data[i] != other[i] { return 0; } i++; }
        if self.data[i] == other[i] { return 1; } return 0;
    }

    pub fn drop(self: *String) {
        free(self.data); free(self);
    }
}