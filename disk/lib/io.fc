fn print_str(str: string) {
    let mut len: int = 0; let mut s: string = str;
    while s[0] != 0 { len++; s = s + 1; }
    syscall(4, 1, str, len, 0);  
}

fn print_int(n: int) {
    if n == 0 { print_str("0"); return; }
    let mut buf: string = alloc(16); 
    let mut temp: int = n; let mut is_neg: int = 0;
    if temp < 0 { is_neg = 1; temp = 0 - temp; }
    let mut i: int = 0;
    while temp > 0 { buf[i] = (temp % 10) + 48; i++; temp = temp / 10; }
    if is_neg == 1 { buf[i] = 45; i++; }
    
    let mut start: int = 0; let mut end: int = i - 1;
    while start < end { let mut t: char = buf[start]; buf[start] = buf[end]; buf[end] = t; start++; end--; }
    buf[i] = 0; print_str(buf); free(buf);
}

fn println(str: string) { print_str(str); print_str("\n"); }

fn read_char() -> char {
    let mut c: char = 0;
    syscall(3, 0, &c, 1, 0);
    return c;
}