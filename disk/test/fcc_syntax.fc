// =========================================
// 8086-OS FEMOC Syntax Guide
// =========================================

// 1. VARIABLES AND MUTTABLE OR IMMUTTABLE
let x: i32 = 10;
// x = 20; //ERROR!

let mut y: i32 = 20;
y = 30;
y += 5;
y++;

// 2. FUNCTIONS
fn add(a: i32, b: i32) -> i32 {
    let result: i32 = a + b;
    return result; //can be written without ';' (experimental)
}

fn print_message() -> void {
    printf("Hello from FCC!\n");
}

fn main() -> i32 {
    print_message();
    let sum: i32 = add(10, 5);
    
    return 0;
}

// 3. ARRAYS
fn array_test() -> void {
    //[type, size]
    let mut buffer: [u8; 256]; 
    buffer[0] = 65; // 'A'
}

// 4. STRUCTS
struct Point {
    x: i32,
    y: i32
}

fn struct_test() -> void {
    let mut p: Point;
    p.x = 100;
    p.y = 200;
}

// 5. POINTERS
fn pointer_test(ptr: *i32) -> void {
    let mut val: i32 = *ptr;
    val += 1;
}

// 6. LOOPS
fn loops() -> void {
    let mut i: i32 = 0;
    while i < 10 {
        i++;
    }
}